# ─────────────────────────────────────────────────────────────────────────────
# Ptah Tours — environment configuration
# Copy to `.env` (`Copy-Item .env.example .env`) and fill in real values.
# `.env` is git-ignored; never commit real secrets.
# Validated at boot by src/lib/env.ts (zod) — the app refuses to start with
# missing/invalid required variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8, see docker-compose.yml) ───────────────────────────────
# Pooled/app connection used by Prisma at runtime.
DATABASE_URL="mysql://ptah:ptah-dev-password@localhost:3306/ptah_tours"
# Optional direct (non-pooled) connection, e.g. for migrations against a
# proxied production setup. Falls back to DATABASE_URL when unset.
DATABASE_URL_DIRECT=""

# ── Auth (Auth.js / NextAuth v5 — wired in a later phase) ────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Required in every environment before auth ships. AUTH_SECRET is the v5 name;
# NEXTAUTH_SECRET is accepted as a legacy alias.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Canonical site URL used for auth callbacks & absolute links.
# Dev:  http://localhost:3000
AUTH_URL="http://localhost:3000"

# ── Admin login via env (optional) ───────────────────────────────────────────
# Applied at boot by src/server/auth/admin-sync.ts: ensures a SUPER_ADMIN with
# this email/password exists. Set ADMIN_EMAIL plus ONE of the two passwords.
# Change the values + redeploy to change the admin login.
ADMIN_EMAIL=""
ADMIN_NAME=""
# Plaintext password (hashed with argon2id at boot):
ADMIN_PASSWORD=""
# OR a pre-computed argon2id hash (preferred — no plaintext in env):
ADMIN_PASSWORD_HASH=""

# ── Payments & integrations via env ──────────────────────────────────────────
# ANY integration field can be supplied from the environment with the pattern
#   INTEGRATION_<KEY>_<FIELD>
# which OVERRIDES the admin-panel vault per field (server-only, never logged).
# Keys/fields come from the registry in src/server/integrations.ts, e.g.:
#   Stripe:  INTEGRATION_STRIPE_PUBLISHABLE_KEY / _SECRET_KEY / _WEBHOOK_SECRET
#   PayPal:  INTEGRATION_PAYPAL_CLIENT_ID / _CLIENT_SECRET / _ENVIRONMENT (live|sandbox) / _WEBHOOK_ID
#   Paymob:  INTEGRATION_PAYMOB_API_KEY / _INTEGRATION_ID
#   (same scheme for GA4, GTM, SENDGRID, … )
# INTEGRATION_STRIPE_SECRET_KEY=""
# INTEGRATION_PAYPAL_CLIENT_ID=""
# INTEGRATION_PAYPAL_CLIENT_SECRET=""
# INTEGRATION_PAYPAL_ENVIRONMENT="live"
#
# Legacy Stripe-only aliases (still honored as a fallback):
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Offline bank-transfer instructions shown at checkout when that method is on.
# Free text (account name/number/IBAN/reference guidance). Leave blank and the
# page tells customers the details will be emailed — never invents numbers.
BANK_TRANSFER_INSTRUCTIONS=""

# ── Public site URL (exposed to the browser, must be NEXT_PUBLIC_*) ──────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Rate limiting (optional) ─────────────────────────────────────────────────
# Set to a Redis connection string to share rate-limit counters across all app
# instances (needed when running more than one process behind a load balancer).
# Leave blank for the in-memory limiter, which is correct for a single process.
REDIS_URL=""

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=""

# ── Analytics / tag manager (optional, public ids — wired via Integration) ───
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# ── Application environment ──────────────────────────────────────────────────
# One of: development | test | production. Defaults to NODE_ENV when unset.
APP_ENV="development"

# ── Feature flags (boot defaults; DB SiteToggle rows override at runtime) ────
FEATURE_SIGNUP_ENABLED="true"
FEATURE_LOGIN_ENABLED="true"
FEATURE_STRIPE_PAYMENTS_ENABLED="false"
FEATURE_PAYPAL_PAYMENTS_ENABLED="false"
FEATURE_BANK_TRANSFER_ENABLED="false"
FEATURE_MAINTENANCE_MODE="false"

# -- Security headers (read directly by src/proxy.ts, NOT by env.ts) -----------
# "1" = strict per-request CSP nonce (requires every route to be dynamically
# rendered). Leave unset for the static-safe default policy. See src/proxy.ts.
SECURITY_CSP_NONCE=""

# -- Logging (read directly by src/lib/logger.ts, NOT by env.ts) --------------
# One of: debug | info | warn | error. Dev default: debug; production: info.
LOG_LEVEL=""