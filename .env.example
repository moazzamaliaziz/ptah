# ─────────────────────────────────────────────────────────────────────────────
# Ptah Tours — environment configuration
# Copy to `.env` (`Copy-Item .env.example .env`) and fill in real values.
# `.env` is git-ignored; never commit real secrets.
# Validated at boot by src/lib/env.ts (zod) — the app refuses to start with
# missing/invalid required variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8, see docker-compose.yml) ───────────────────────────────
# Pooled/app connection used by Prisma at runtime.
DATABASE_URL="mysql://ptah:ptah-dev-password@localhost:3306/ptah_tours"
# Optional direct (non-pooled) connection, e.g. for migrations against a
# proxied production setup. Falls back to DATABASE_URL when unset.
DATABASE_URL_DIRECT=""

# ── Auth (Auth.js / NextAuth v5 — wired in a later phase) ────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Required in every environment before auth ships. AUTH_SECRET is the v5 name;
# NEXTAUTH_SECRET is accepted as a legacy alias.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Canonical site URL used for auth callbacks & absolute links.
# Dev:  http://localhost:3000
AUTH_URL="http://localhost:3000"

# ── Payments (Stripe) — later phase ──────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Public site URL (exposed to the browser, must be NEXT_PUBLIC_*) ──────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=""

# ── Analytics / tag manager (optional, public ids — wired via Integration) ───
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""

# ── Application environment ──────────────────────────────────────────────────
# One of: development | test | production. Defaults to NODE_ENV when unset.
APP_ENV="development"

# ── Feature flags (boot defaults; DB SiteToggle rows override at runtime) ────
FEATURE_SIGNUP_ENABLED="true"
FEATURE_LOGIN_ENABLED="true"
FEATURE_STRIPE_PAYMENTS_ENABLED="false"
FEATURE_MAINTENANCE_MODE="false"

# -- Security headers (read directly by src/proxy.ts, NOT by env.ts) -----------
# "1" = strict per-request CSP nonce (requires every route to be dynamically
# rendered). Leave unset for the static-safe default policy. See src/proxy.ts.
SECURITY_CSP_NONCE=""

# -- Logging (read directly by src/lib/logger.ts, NOT by env.ts) --------------
# One of: debug | info | warn | error. Dev default: debug; production: info.
LOG_LEVEL=""